{
  "name": "mone-button",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:i18n": "node scripts/check-i18n.mjs",
    "build": "npm run check:i18n && tsc -b && vite build",
    "lint": "eslint .",
    "test": "node --test scripts/*.test.js scripts/create-video/*.test.js scripts/create-video/qc/*.test.js scripts/create-video/qc/checks/*.test.js scripts/dev-server/lib/*.test.js scripts/dev-server/handlers/*.test.js scripts/youtube-upload/*.test.js",
    "golden:ass": "node scripts/create-video/golden-ass.mjs",
    "preview": "vite preview",
    "editor": "vite --open /mone-button/editor.html",
    "crop": "vite --open /mone-button/crop.html",
    "sync": "node scripts/sync.js",
    "extract": "node scripts/extract.js",
    "download": "node scripts/download.js",
    "import": "npm run sync && npm run extract && npm run download",
    "createVideo": "node scripts/create-video/index.js",
    "upload": "node scripts/youtube-upload/index.js",
    "qc": "node scripts/create-video/qc/index.js",
    "fixCacheAudio": "node scripts/create-video/fix-cache-audio.mjs",
    "fixClipLoudness": "node scripts/fix-clip-loudness.js",
    "still": "node scripts/create-video/preview.js",
    "shots": "node scripts/ui/shots.mjs",
    "cropVideo": "node scripts/create-video/crop-export.js",
    "thumb": "vite --open /mone-button/thumb.html"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.10",
    "@eslint/js": "^10.0.1",
    "@googleapis/youtube": "^40.0.2",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "kuromoji": "^0.1.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  }
}
