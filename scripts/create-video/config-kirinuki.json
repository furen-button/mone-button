{
  "select": {
    "mode": "category",
    "videoId": null,
    "order": "date",
    "limit": null,
    "categories": [
      "やられ"
    ]
  },
  "output": {
    "resolution": "1920x1080",
    "fps": 30,
    "name": null
  },
  "source": "cache",
  "normalizeCache": true,
  "font": "Hiragino Sans",
  "fontsDir": "/System/Library/Fonts",
  "telops": {
    "title": {
      "enabled": true,
      "align": "top-center",
      "size": 0.03,
      "minSize": 0.022,
      "marginH": 0.11,
      "format": "{title}",
      "singleLine": true,
      "font": "Hiragino Sans W8",
      "color": "FFFFFF",
      "outlines": [
        {
          "width": 3,
          "color": "3B2366"
        }
      ],
      "box": {
        "enabled": true,
        "fill": "7E57C2",
        "pad": 8,
        "minHeight": 0.055,
        "opacity": 1
      },
      "fade": [
        0,
        0
      ]
    },
    "date": {
      "enabled": true,
      "align": "top-left",
      "size": 0.03,
      "color": "FFFFFF",
      "marginV": 0.0125
    },
    "time": {
      "enabled": true,
      "align": "top-right",
      "size": 0.03,
      "color": "FFFFFF",
      "marginV": 0.0125
    },
    "serif": {
      "enabled": true,
      "align": "bottom-center",
      "size": 0.095,
      "font": "Hiragino Sans W9",
      "autoShrink": true,
      "minSize": 0.06,
      "maxHeight": 0.24,
      "marginH": 0.06,
      "marginV": 0.04,
      "color": "FF4FA0",
      "bold": false,
      "shadow": 3,
      "fade": [
        80,
        80
      ],
      "box": {
        "enabled": false
      },
      "outlines": [
        {
          "width": 9,
          "color": "FFFFFF"
        },
        {
          "width": 4,
          "color": "6B3FA0"
        }
      ],
      "emphasis": {
        "color": "FFD800"
      },
      "karaoke": false,
      "avoidFace": {
        "enabled": false
      }
    },
    "progress": {
      "enabled": false
    }
  },
  "cards": {
    "enabled": false,
    "se": {
      "enabled": false
    }
  },
  "endcaps": {
    "opening": {
      "enabled": false
    },
    "ending": {
      "enabled": true,
      "video": "assets/create-video/endcard-pink-04-pop-bg035.mp4",
      "duration": 20,
      "layout": "endscreen",
      "font": "Hiragino Sans W9",
      "endscreen": {
        "background": {
          "type": "lastClip",
          "blur": 40,
          "brightness": -0.08
        },
        "labels": {
          "top": "おすすめアーカイブはこちら",
          "bottom": "登録がまだの方はこちら"
        },
        "label": {
          "size": 0.065,
          "color": "FFFFFF",
          "outlines": [
            {
              "width": 6,
              "color": "3B2366"
            }
          ]
        }
      }
    }
  },
  "transitions": {
    "mode": "stream",
    "type": "whip",
    "duration": 0.5,
    "se": {
      "enabled": true,
      "file": "assets/create-video/シーン切り替え1.mp3",
      "volume": 0.5
    }
