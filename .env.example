VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# ローカル開発で再生回数の書き込みを試す場合のみ true（既定は本番のみ書き込み）
VITE_PLAY_COUNT_DEV_WRITE=

# dev クリップ編集の文字起こし（サーバ専用。VITE_ 接頭辞を付けない）
# .env / .env.local に記載可。プロセス環境変数の値が優先される。
# whisper-cli の実行名またはパス（既定: whisper-cli、PATH 上に必要）
WHISPER_CLI=whisper-cli
# Whisper モデル（ggml-*.bin）の絶対パス。必須で既定値は無い（マシンごとの値なので .env.local に書く）
WHISPER_MODEL_PATH=
# 音声の言語（既定: ja）
WHISPER_LANGUAGE=ja

# YouTube へのアップロード（npm run upload 専用。VITE_ 接頭辞を付けない）
# 優先順位はプロセス環境変数 > .env.local > .env。認証情報は .env.local に書く。
# Google Cloud のデスクトップアプリ用 OAuth クライアント
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# npm run upload -- --login が書き込む。端末には出さない
YOUTUBE_REFRESH_TOKEN=
# 上げ先チャンネル（UC...）。トークンと違えば停止。空なら --login が書き込む
YOUTUBE_CHANNEL_ID=
